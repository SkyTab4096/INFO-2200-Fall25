<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndersonKParticipation07.WeatherPage"
             Title="WeatherPage">
    <StackLayout>
        <Label x:Name="LblCity" Text="City Name..." VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" FontSize="Large"/>
        <Label x:Name="LblCurTemp" Text="Current Temp..." VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" FontSize="Large"/>
        <Label x:Name="LblHighTemp" Text="High Temp..." VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" FontSize="Large"/>
        <Label x:Name="LblLowTemp" Text="Low Temp..." VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" FontSize="Large"/>
    </StackLayout>
</ContentPage>